GO_ENV=development
API_NAME=Go-Application-Template
API_VERSION=v1
PORT=8000

# Postgres. Set DATABASE_URL to override every DB_* field below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_dev
DB_SSLMODE=disable

# Pool tuning (optional — these are the defaults)
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s

# JWT — HS256 via jwt.Manager (JWT_SECRET required; the rest have defaults).
# The secret must be at least 32 bytes (RFC 7518 §3.2) — jwt.NewManager rejects
# anything shorter. Generate a real one with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-0123456789abcdef
# JWT_TTL must carry a unit (24h, 15m); a bare number is a startup error, not a
# silent fallback to the default.
JWT_ISSUER=Go-Application-Template
JWT_TTL=24h

# JWT — RS256 via jwt.RSAManager (alternative to the above; uses JWT_ISSUER/
# JWT_TTL too). Needs 2048+ bit keys, e.g.:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# JWT_RSA_PRIVATE_KEY_PATH=./private.pem
# JWT_RSA_PUBLIC_KEY_PATH=./public.pem
